{
  "components": {
    "schemas": {
      "CreateRunRequest": {
        "properties": {
          "spec_id": {
            "title": "Spec Id",
            "type": "string"
          }
        },
        "required": [
          "spec_id"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RunCreatedResponse": {
        "properties": {
          "phase": {
            "title": "Phase",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "phase"
        ],
        "title": "RunCreatedResponse",
        "type": "object"
      },
      "RunStatusResponse": {
        "properties": {
          "expected_case_count": {
            "title": "Expected Case Count",
            "type": "integer"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "interrupt": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interrupt"
          },
          "phase": {
            "title": "Phase",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "settled_case_count": {
            "title": "Settled Case Count",
            "type": "integer"
          },
          "spec_fingerprint": {
            "title": "Spec Fingerprint",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "phase",
          "spec_fingerprint",
          "expected_case_count",
          "settled_case_count"
        ],
        "title": "RunStatusResponse",
        "type": "object"
      },
      "SpecCreatedResponse": {
        "properties": {
          "declared_targets": {
            "description": "从 servers 提取的出站目标，值为 `scheme://host:port`。为空意味着所有请求都会被 Guardrail 拒绝。",
            "items": {
              "type": "string"
            },
            "title": "Declared Targets",
            "type": "array"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "openapi_version": {
            "title": "Openapi Version",
            "type": "string"
          },
          "operation_count": {
            "title": "Operation Count",
            "type": "integer"
          },
          "reused": {
            "description": "指纹命中已有 Spec 时为 true——**没有重新解析、没有重复落库**",
            "title": "Reused",
            "type": "boolean"
          },
          "spec_id": {
            "title": "Spec Id",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/WarningItem"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "spec_id",
          "fingerprint",
          "openapi_version",
          "operation_count",
          "declared_targets",
          "reused"
        ],
        "title": "SpecCreatedResponse",

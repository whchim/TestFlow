# TestFlow 配置示例
# 复制为 .env 后填写。所有变量以 TESTFLOW_ 为前缀。
#
# ⚠️ 这里**没有**安全底线的开关（元数据拒绝、重定向、破坏性方法等）——
#    它们是硬编码行为，见 ADR-0022。判断标准：改了这个值会不会让安全性变差。

# ---- 运行 ----
TESTFLOW_BIND_HOST=127.0.0.1
TESTFLOW_BIND_PORT=3000
TESTFLOW_LOG_LEVEL=INFO

# ---- 存储 ----
TESTFLOW_DATABASE_URL=postgresql+psycopg://testflow:testflow@localhost:5432/testflow
TESTFLOW_REDIS_URL=redis://localhost:6379
TESTFLOW_REDIS_BROKER_DB=0
TESTFLOW_REDIS_CHECKPOINT_DB=1

# ---- 认证 ----
# api_token 仅在 bind_host 非环回时必填；填了会强制它与 internal_token 不同
# TESTFLOW_API_TOKEN=
TESTFLOW_INTERNAL_TOKEN=dev-internal-token-change-me
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TESTFLOW_CREDENTIAL_ENCRYPTION_KEY=

# ---- LLM（阿里云百炼，OpenAI 兼容模式）----
TESTFLOW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TESTFLOW_LLM_API_KEY=
TESTFLOW_LLM_MODEL=qwen3.5-plus

# ---- Guardrail（仅阈值与白名单）----
# 内网例外的唯一来源，永不从 Spec 派生（ADR-0018）
# TESTFLOW_GUARDRAIL_ALLOW_PRIVATE_TARGETS=["127.0.0.1:9000"]
